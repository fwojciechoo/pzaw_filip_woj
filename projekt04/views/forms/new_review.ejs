<% if (locals.errors && errors.length > 0) { %>
  <ul id="errors">
    <% errors.forEach(function(error) { %>
      <li><%= error %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/add_review/<%= hotel.slug %>" method="POST" class="review-form">
  <div class="form-field">
    <label for="review_title">Tytuł</label>
    <input
      type="text"
      name="title"
      id="review_title"
      required
      minlength="3"
      maxlength="100"
      value="<%= locals.title_value || "" %>"
    />
  </div>

  <div class="form-field">
    <label for="review_content">Tekst</label>
    <textarea
      name="content"
      id="review_content"
      required
      minlength="10"
      maxlength="500"
    ><%= locals.content_value || "" %></textarea>
  </div>

  <div class="form-actions">
    <button>Dodaj</button>
  </div>
</form>